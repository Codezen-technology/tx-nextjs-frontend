# =====================================================================
# Local development — points at https://lms-site.test/ (WPLMS backend)
# =====================================================================

NEXT_PUBLIC_WP_API_URL=https://lms-site.test
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trust the Valet self-signed CA so Node.js fetch can reach https://lms-site.test
NODE_EXTRA_CA_CERTS=/Users/codeentechnologies/.config/valet/CA/LaravelValetCASelfSigned.pem
NEXT_PUBLIC_LMS_NAMESPACE=lms-backend/v1

# Per-request ceiling (ms) on every server-side WordPress fetch. Defaults to 15000.
# Server-only. Raise it for a genuinely slow backend; do NOT raise
# `staticPageGenerationTimeout` instead — that only delays the same build failure.
# WP_FETCH_TIMEOUT_MS=15000
NEXT_PUBLIC_B2B_NAMESPACE=lms-b2b/v1
NEXT_PUBLIC_CDN_URL="https://cdn.codeen.com/tx-headless-frontend" # Optional CDN URL for static assets (defaults to SITE_URL if not set)

# Firebase social sign-in (Console → Project Settings → Your apps → Web app config)
# Project ID must match LMS_BACKEND_API_FIREBASE_PROJECT_ID in wp-config.php
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Comma-separated, must match what's actually enabled in Console → Authentication → Sign-in method
NEXT_PUBLIC_FIREBASE_ENABLED_PROVIDERS=google

# Optional overrides (pulled from /settings by default)
NEXT_PUBLIC_CURRENCY=GBP
NEXT_PUBLIC_LOCALE=en-GB

# Feature flags
NEXT_PUBLIC_FEATURE_MEMBERSHIPS=true
NEXT_PUBLIC_FEATURE_BUNDLES=true
NEXT_PUBLIC_FEATURE_CERTIFICATES=true
NEXT_PUBLIC_FEATURE_BADGES=false
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_BLOG=true

WC_CONSUMER_KEY=ck_06d4a21f626dc710a8f1ea0c38644838f9f88203
WC_CONSUMER_SECRET=cs_f13eb2a214588b9e48d21257fbfba9031d727116

# Stripe secret key (server-only) — Dashboard → Developers → API keys → Secret key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51IeFSiDfPe41flWVJa3ydM6odGIDmxjg5xxmzB66vpGKcVOHs9WveuPdt4rg2nyrJFZZF8MMty1LxAQKNQj3gE7J00vHDdEu55
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe webhook signing secret (server-only)
STRIPE_WEBHOOK_SECRET=
# Shared secret for server->WP plugin calls (matches wp-config LMS_BACKEND_API_INTERNAL_SECRET)
WP_INTERNAL_SECRET=

# Live chat (Codezen Custom Live Chat) — leave unset to disable the widget
# entirely: no script tag, no request to any chat origin. Set only where chats
# should reach the real agent inbox.
# Prerequisite lives in the chat admin, not here: a brand whose `domain` is this
# site's hostname (hostname only — no scheme, no port), or chats arrive untagged.
# NEXT_PUBLIC_LIVE_CHAT_WIDGET_URL=https://chat-widget.easychat.org.uk/widget.js

# On-demand cache purge. WordPress sends this in the `x-wp-revalidate-secret`
# header on POST /api/revalidate when an editor saves; it must match on both
# sides. Server-only — never expose it to the browser.
#
# Leaving it UNSET is a valid configuration: the endpoint then rejects every
# request and cached content refreshes on its own TTL (settings within 5 min).
# It is never "unset = open".
#
# Preview deployments pointing at the same WordPress instance receive the same
# purge calls. Harmless — each deployment purges only its own cache.
# WP_REVALIDATE_SECRET=
